{
  "expo": {
    "name": "Neylo",
    "slug": "min_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/neylo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spandur0.min-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fdfcfb",
        "foregroundImage": "./assets/branding/neylo-icon.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/branding/neylo-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fefcfa",
          "image": "./assets/branding/neylo-splash.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/branding/neylo-symbol.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Neylo to use Face ID to protect your financial information."
        }
      ]
    ]
  }
}
